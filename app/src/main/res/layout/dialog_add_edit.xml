<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin phòng trọ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/edtDialogRoomId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã phòng (vd: P101)"
            android:inputType="textCapCharacters"/>

        <EditText
            android:id="@+id/edtDialogRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên phòng"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/edtDialogPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá thuê (VNĐ)"
            android:inputType="numberDecimal"
            android:layout_marginTop="10dp"/>

        <CheckBox
            android:id="@+id/cbDialogAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Còn trống (Xanh)"
            android:checked="true"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/edtDialogTenant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên người thuê (nếu có)"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/edtDialogPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số điện thoại"
            android:inputType="phone"
            android:layout_marginTop="10dp"/>

    </LinearLayout>
</ScrollView>
